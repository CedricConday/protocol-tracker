{
  "expo": {
    "name": "Protocol Tracker",
    "slug": "protocol-tracker",
    "version": "1.0.0",
    "description": "Protocol Tracker helps patients on high-dose Vitamin D3 therapy log doses, schedule pill reminders, and monitor symptoms \u2014 all privately on-device.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.protocoltracker.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F4"
      },
      "package": "com.protocoltracker.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Protocol Tracker uses your location to show local UV index and air quality for your protocol."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c6ea28d8-fbbe-47ba-b70f-1092e1c7a355"
      }
    },
    "owner": "<expo-account>",
    "runtimeVersion": "exposdk:54.0.0",
    "updates": {
      "url": "https://u.expo.dev/c6ea28d8-fbbe-47ba-b70f-1092e1c7a355"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "privacy": "public"
  }
}