# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# local tooling config
.claude/

# generated native folders
/ios
/android

# storybook build output
storybook-static/

# local holding pen (removed/parked files, dev logs) — never ships
.holding/

# e2e run artefacts (screenshots, per-run reports) — 58M and regenerated per run
e2e/report/

# published design-canvas bundles: generated wrappers that embed the .dc.html
# artboards. The artboards and canvas.json are the source; these are output.
design/protocol-tracker-app.html
design/palettes/protocol-tracker-palettes.html
