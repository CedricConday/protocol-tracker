# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# local tooling config
.claude/

# generated native folders
/ios
/android

# storybook build output
storybook-static/

# local holding pen (removed/parked files, dev logs) — never ships
.holding/

# e2e run artefacts (screenshots, per-run reports) — 58M and regenerated per run
e2e/report/

# published design-canvas bundles: generated wrappers that embed the .dc.html
# artboards. The artboards and canvas.json are the source; these are output.
design/protocol-tracker-app.html
design/palettes/protocol-tracker-palettes.html

# folded-in research notes: named clinical material about a real person.
# Lives with the app on this box, deliberately never enters git or GitHub.
research/

# internal running record: task lists, status logs, agent instructions, build
# notes and the marketing hand-offs. They stay on this box at these paths and
# are deliberately not part of the public repo (2026-09-21, pre-launch).
/TASKS.md
/PT-trio.md
/STATUS.md
/BUILD_NOTES_2026-07-07.md
/AGENTS.md
/CLAUDE.md
/LAB_RESULTS.md
/BACKTEST_60D.md
/BACKTEST_PM30D.md
/marketing/
/docs/MARKETING.md
/docs/HANDOFF_MRI_AUTOFILL.md
